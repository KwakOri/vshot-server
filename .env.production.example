# Docker/Vultr production configuration
NODE_ENV=production
PORT=3000

# Comma-separated browser origins. Keep this explicit.
CORS_ORIGIN=https://vshot.site
SERVER_URL=https://stream.vshot.site
APP_URL=https://vshot.site

# Upload limits / local fallback directory
STORAGE_PATH=/app/uploads
MAX_FILE_SIZE=52428800

# API and application secrets — set on Vultr, never commit real values.
API_KEY=__SET_ON_VULTR__
INTERNAL_STATUS_API_KEY=__SET_ON_VULTR__
JWT_SECRET=__SET_ON_VULTR__

# Supabase service-role connection
SUPABASE_URL=https://asnartyfsmmiudqxfwza.supabase.co
SUPABASE_SERVICE_ROLE_KEY=__SET_ON_VULTR__

# Cloudflare R2
R2_ACCOUNT_ID=__SET_ON_VULTR__
R2_ACCESS_KEY_ID=__SET_ON_VULTR__
R2_SECRET_ACCESS_KEY=__SET_ON_VULTR__
R2_BUCKET_NAME=__SET_ON_VULTR__
R2_PUBLIC_URL=https://storage.vshot.site

# Coturn — leave blank until turn.vshot.site and TLS 5349 are configured.
TURN_SERVER_URL=
TURN_USERNAME=
TURN_CREDENTIAL=
